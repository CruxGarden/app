{
  "name": "crux-garden",
  "private": true,
  "version": "3.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite --port 8080",
    "dev": "vite --port 8080",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 8080",
    "desktop": "./scripts/desktop.sh",
    "desktop:dev": "./scripts/desktop.sh --dev",
    "desktop:rebuild": "./scripts/desktop.sh --rebuild",
    "desktop:selftest": "./scripts/desktop.sh --selftest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/api/generated/schema.d.ts --default-non-nullable false",
    "ai:smoke": "node scripts/ai-smoke.mjs",
    "5ws:harness": "esbuild scripts/5ws-harness.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --log-level=warning --outfile=node_modules/.cache/5ws-harness.mjs && node node_modules/.cache/5ws-harness.mjs",
    "verify": "tsc -b --noEmit && eslint src --max-warnings=0 && vitest run && vite build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@google/genai": "^1.45.0",
    "@monaco-editor/react": "^4.7.0",
    "ai": "^7.0.47",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "material-icon-theme": "^5.32.0",
    "openai": "^6.27.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.0.0",
    "react-arborist": "^3.4.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-mosaic-component": "^6.1.1",
    "react-photo-view": "^1.2.7",
    "react-router": "^7.1.0",
    "react-router-dom": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tone": "^15.1.22",
    "wa-sqlite": "^1.0.0",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "react-dnd": "$react-dnd",
    "react-dnd-html5-backend": "$react-dnd-html5-backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "monaco-editor": "^0.55.1",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
