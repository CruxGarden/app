---
// Crux Garden: one recipe — the numbers up top, the ingredients and method from
// the body, a print button and a print stylesheet so it works at the stove.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { formatDate } from '../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('recipes');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const total = entry.data.prepTime + entry.data.cookTime;
const recipeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: entry.data.title,
  description: entry.data.description,
  recipeCategory: entry.data.category,
  recipeYield: `${entry.data.servings} servings`,
  prepTime: `PT${entry.data.prepTime}M`,
  cookTime: `PT${entry.data.cookTime}M`,
  totalTime: `PT${total}M`,
  keywords: entry.data.tags.join(', '),
  datePublished: entry.data.publishDate.toISOString(),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  image={withBase(`/og/recipes/${entry.id}.png`)}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(recipeSchema)} />
  <article class="recipe" data-pagefind-body>
    <header class="page-head section article-head">
      <p class="eyebrow">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <dl class="recipe-facts" aria-label="Recipe facts">
        <div><dt>Prep</dt><dd>{entry.data.prepTime} min</dd></div>
        <div><dt>Cook</dt><dd>{entry.data.cookTime} min</dd></div>
        <div><dt>Total</dt><dd>{total} min</dd></div>
        <div><dt>Serves</dt><dd>{entry.data.servings}</dd></div>
      </dl>
      <div class="entry-meta">
        <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
        {entry.data.tags.length > 0 && <span>{entry.data.tags.join(' / ')}</span>}
      </div>
      <div class="action-row recipe-actions">
        <button class="button" type="button" onclick="window.print()">Print recipe</button>
      </div>
      {
        entry.data.image && (
          <Image
            class="article-image"
            src={entry.data.image}
            alt=""
            widths={[720, 1040, 1400]}
            sizes="(min-width: 900px) 72rem, 100vw"
          />
        )
      }
    </header>
    <div class="section prose recipe-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .recipe-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 1rem 0 0;
  }
  .recipe-facts div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .recipe-facts dt {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted, #697080);
  }
  .recipe-facts dd {
    margin: 0;
    font-weight: 600;
  }
  .recipe-body :global(h2) {
    margin-top: 2rem;
  }
  .recipe-body :global(ul li) {
    list-style: none;
    padding-left: 1.6rem;
    position: relative;
  }
  .recipe-body :global(ul li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.8rem;
    height: 0.8rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    opacity: 0.6;
  }
  @media print {
    :global(header.site-header),
    :global(footer),
    :global(nav),
    .recipe-actions,
    .article-image {
      display: none !important;
    }
    :global(body) {
      background: #fff;
      color: #000;
      font-size: 12pt;
    }
    .recipe {
      max-width: none;
    }
    .recipe-body :global(ul li)::before {
      opacity: 1;
    }
  }
</style>
