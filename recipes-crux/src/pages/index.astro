---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const recipes = (await getCollection('recipes'))
  .filter((recipe) => !recipe.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <p class="eyebrow">{SITE.description}</p>
    <h1>{SITE.title}</h1>
    {SITE.about && <p class="lead">{SITE.about}</p>}
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/recipes/')}>Browse recipes</a>
      <a class="text-link" href={withBase('/blog/')}>{t('home.readNotes')}</a>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-recipes">
    <div class="section-heading">
      <p class="eyebrow">Latest recipes</p>
      <h2 id="latest-recipes">Recipes</h2>
      <a class="text-link" href={withBase('/recipes/')}>All recipes</a>
    </div>

    {
      recipes.length > 0 ? (
        <div class="highlight-grid">
          {recipes.map((recipe) => (
            <article class="highlight-card">
              {recipe.data.image && (
                <Image src={recipe.data.image} alt="" width={720} height={480} loading="lazy" />
              )}
              <div>
                <p class="meta">
                  {recipe.data.category} · {recipe.data.prepTime + recipe.data.cookTime} min · serves{' '}
                  {recipe.data.servings}
                </p>
                <h3>
                  <a href={withBase(`/recipes/${recipe.id}/`)}>{recipe.data.title}</a>
                </h3>
                <p>{recipe.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>Add recipes under <code>src/content/recipes</code> and the newest appear here.</p>
        </div>
      )
    }
  </section>

  <section class="section index-feed" aria-labelledby="latest-notes">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestBlogEyebrow')}</p>
      <h2 id="latest-notes">{t('nav.blog')}</h2>
      <a class="text-link" href={withBase('/blog/')}>{t('home.allPosts')}</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="note-list">
          {posts.map((post) => (
            <article class="note-row">
              {post.data.heroImage && (
                <Image src={post.data.heroImage} alt="" width={320} height={220} loading="lazy" />
              )}
              <div>
                <p class="meta">{formatDate(post.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section>
</BaseLayout>
