# Build-time public configuration (Vite inlines VITE_* into the bundle — never put secrets here).

# The Crux Garden API (auth, sync, publish, crux store).
VITE_API_URL=http://localhost:3000

# Where published cruxes' FILES are served from. Per-crux subdomain in production
# (`{cruxId}` is substituted); unset in local dev, which falls back to a same-origin
# service-worker preview. See src/lib/public-url.ts.
VITE_PUBLISH_ORIGIN_TEMPLATE="https://{cruxId}.publish.crux.garden"

# Legacy flat published-content origin (`${url}/${cruxId}/…`). Only consulted when
# VITE_PUBLISH_ORIGIN_TEMPLATE is unset; leave empty for the per-crux layout.
# VITE_PUBLISHED_CONTENT_URL=https://publish.crux.garden

# Cross-origin preview receiver for the Crux Store postMessage proxy (src/main.tsx,
# src/hooks/useStoreProxy.ts). Unset → a same-origin service worker is registered instead.
VITE_PREVIEW_ORIGIN=https://preview.crux.garden

# The public website origin used in "your site is live at" links. Defaults to
# window.location.origin in the browser and https://crux.garden on desktop (crux-app://).
# VITE_APP_URL=https://crux.garden

# Build the public website instead of the app: `/` becomes the landing page and the
# browser builder routes redirect there (src/lib/site.ts). Set by .github/workflows/deploy-web.yml.
# VITE_PUBLIC_SITE=1
