<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Applied to the Electron helper processes (renderer, GPU, plugin) by electron-builder's
       `entitlementsInherit`. `inherit` takes the parent's hardened-runtime settings; jit +
       unsigned-executable-memory are repeated because the renderer runs V8 too. Nothing else:
       the helpers load no third-party libraries and read no DYLD_* variables (see
       entitlements.mac.plist for why those two keys are absent). -->
  <key>com.apple.security.inherit</key><true/>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
