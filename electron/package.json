{
  "name": "crux-garden-desktop",
  "version": "1.0.0",
  "description": "Crux Garden — a local-first creative workspace: talk to an AI, make something, publish it.",
  "license": "MIT",
  "author": {
    "name": "Crux Garden",
    "email": "keeper@crux.garden"
  },
  "homepage": "https://crux.garden",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "postinstall": "electron-builder install-app-deps",
    "start": "tsc && electron .",
    "dev": "tsc && CRUX_DEV_SERVER=http://localhost:8080 electron .",
    "build:web": "cd .. && npm run build",
    "build:all": "npm run build:web && npm run build",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "dist:mac": "npm run build:all && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build:all && electron-builder --win --publish never",
    "dist:linux": "npm run build:all && electron-builder --linux --publish never",
    "test:e2e": "tsc && playwright test",
    "test:performance": "tsc && playwright test -c playwright.performance.config.ts",
    "test:web": "playwright test -c playwright.web.config.ts",
    "verify": "tsc && eslint src --max-warnings=0",
    "dist:mac:unsigned": "npm run build:all && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "test:packaged": "CRUX_PACKAGED=1 playwright test e2e/packaged.spec.ts",
    "dist:win:unsigned": "npm run build:all && electron-builder --win --publish never",
    "test:e2e:apps": "npm run test:e2e -- e2e/clean-workshop.spec.ts e2e/notes-crux.spec.ts e2e/notes-sharing-layout.spec.ts e2e/moqira-crux.spec.ts e2e/app-appearance.spec.ts e2e/app-workflow.spec.ts e2e/embedded-app-sharing.spec.ts e2e/parallel-tasks.spec.ts e2e/tending.spec.ts e2e/growth-graph.spec.ts e2e/onebigsky.spec.ts e2e/cardinal-crux.spec.ts e2e/tool-sampler.spec.ts e2e/sampler-playback.spec.ts e2e/productivity-tools.spec.ts e2e/cruxspace.spec.ts e2e/openmosh-app.spec.ts e2e/minipaint-app.spec.ts e2e/audiomass-app.spec.ts e2e/bitsy-app.spec.ts e2e/mermaid-app.spec.ts e2e/piskel-app.spec.ts e2e/rawgraphs-app.spec.ts e2e/jupyterlite-app.spec.ts e2e/gephi-app.spec.ts e2e/ketcher-app.spec.ts e2e/twine-app.spec.ts e2e/svgedit-app.spec.ts e2e/blockbench-app.spec.ts e2e/tool-info.spec.ts e2e/workspace-audio-startup.spec.ts e2e/gdevelop-app.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^4.0.3",
    "chokidar-fsevents": "npm:chokidar@3.6.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ignore": "^7.0.5",
    "pnpm": "^10.34.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "garden.crux.app",
    "productName": "Crux Garden",
    "afterSign": "build/ad-hoc-sign.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "dist/mcp-stdio.js",
      "dist/dev-listener.js",
      "node_modules/better-sqlite3/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/pnpm/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app"
      },
      {
        "from": "../src/services/sqlite/schema.sql",
        "to": "schema.sql"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "darkModeSupport": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "maintainer": "keeper@crux.garden",
      "synopsis": "Talk to an AI, make something, publish it."
    },
    "publish": {
      "provider": "github",
      "owner": "CruxGarden",
      "repo": "app",
      "releaseType": "draft"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
