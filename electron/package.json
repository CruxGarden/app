{
  "name": "crux-garden-desktop",
  "version": "1.0.0",
  "description": "Crux Garden \u2014 a local-first creative workspace: talk to an AI, make something, publish it.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "dev": "tsc && CRUX_DEV_SERVER=http://localhost:8080 electron .",
    "build:web": "cd .. && tsc -b && npx vite build",
    "build:all": "npm run build:web && npm run build",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "dist:mac": "npm run build:all && electron-builder --mac dmg zip",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:linux": "npm run build:all && electron-builder --linux --publish never",
    "test:e2e": "tsc && playwright test",
    "verify": "tsc && eslint src --max-warnings=0",
    "dist:mac:unsigned": "npm run build:all && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "test:packaged": "CRUX_PACKAGED=1 playwright test e2e/packaged.spec.ts",
    "dist:win:unsigned": "npm run build:all && electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ignore": "^7.0.5",
    "pnpm": "^10.34.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "garden.crux.app",
    "productName": "Crux Garden",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/pnpm/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app"
      },
      {
        "from": "../src/services/sqlite/schema.sql",
        "to": "schema.sql"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Crux Garden does not record audio; this text is required by macOS for apps that use the audio stack."
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "maintainer": "keeper@crux.garden",
      "synopsis": "Talk to an AI, make something, publish it."
    },
    "publish": {
      "provider": "github",
      "owner": "CruxGarden",
      "repo": "app",
      "releaseType": "draft"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
