{
  "name": "crux-garden-desktop",
  "version": "3.0.0",
  "description": "Crux Garden Desktop — Electron wrapper with native SQLite",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "dev": "tsc && electron .",
    "build:web": "cd .. && tsc -b && npx vite build",
    "build:all": "npm run build:web && npm run build",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:linux": "npm run build:all && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "garden.crux.app",
    "productName": "Crux Garden",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app"
      },
      {
        "from": "../src/services/sqlite/schema.sql",
        "to": "schema.sql"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
