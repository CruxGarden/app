---
// Crux Garden: the shop — every product, grouped by category.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyButton from '../../components/BuyButton.astro';
import { withBase } from '../../lib/url';
import { SITE } from '../../consts';

const products = (await getCollection('products'))
  .filter((product) => !product.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const categories = [...new Set(products.flatMap((p) => (p.data.categories.length ? p.data.categories : ['Everything'])))].sort();
const inCategory = (category: string) =>
  products.filter((p) => (p.data.categories.length ? p.data.categories : ['Everything']).includes(category));
---

<BaseLayout title="Shop" description={`Everything in ${SITE.title}.`}>
  <section class="page-head section">
    <p class="eyebrow">Shop</p>
    <h1>{SITE.title}</h1>
    <p class="lead">{products.length} {products.length === 1 ? 'product' : 'products'}.</p>
  </section>
  {
    categories.map((category) => (
      <section class="section" aria-label={category}>
        <div class="section-heading">
          <p class="eyebrow">{category}</p>
        </div>
        <div class="highlight-grid">
          {inCategory(category).map((product) => (
            <article class="highlight-card product-card">
              {product.data.image && (
                <a href={withBase(`/shop/${product.id}/`)}>
                  <Image src={product.data.image} alt="" width={720} height={480} loading="lazy" />
                </a>
              )}
              <div>
                <h3>
                  <a href={withBase(`/shop/${product.id}/`)}>{product.data.name}</a>
                </h3>
                <p>{product.data.description}</p>
                <div class="action-row">
                  <BuyButton product={product} />
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
