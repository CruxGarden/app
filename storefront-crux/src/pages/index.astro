---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const products = (await getCollection('products'))
  .filter((product) => !product.data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);
const money = (value: number, currency: string) =>
  new Intl.NumberFormat(SITE.locale, { style: 'currency', currency }).format(value);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <p class="eyebrow">{SITE.description}</p>
    <h1>{SITE.title}</h1>
    {SITE.about && <p class="lead">{SITE.about}</p>}
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/shop/')}>Browse the shop</a>
      <a class="text-link" href={withBase('/blog/')}>{t('home.readNotes')}</a>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="featured-products">
    <div class="section-heading">
      <p class="eyebrow">In the shop</p>
      <h2 id="featured-products">Products</h2>
      <a class="text-link" href={withBase('/shop/')}>Everything</a>
    </div>

    {
      products.length > 0 ? (
        <div class="highlight-grid">
          {products.map((product) => (
            <article class="highlight-card">
              {product.data.image && (
                <Image src={product.data.image} alt="" width={720} height={480} loading="lazy" />
              )}
              <div>
                <p class="meta">{money(product.data.price, product.data.currency)}</p>
                <h3>
                  <a href={withBase(`/shop/${product.id}/`)}>{product.data.name}</a>
                </h3>
                <p>{product.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>Add products under <code>src/content/products</code> and they appear here.</p>
        </div>
      )
    }
  </section>

  <section class="section index-feed" aria-labelledby="latest-notes">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestBlogEyebrow')}</p>
      <h2 id="latest-notes">{t('nav.blog')}</h2>
      <a class="text-link" href={withBase('/blog/')}>{t('home.allPosts')}</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="note-list">
          {posts.map((post) => (
            <article class="note-row">
              {post.data.heroImage && (
                <Image src={post.data.heroImage} alt="" width={320} height={220} loading="lazy" />
              )}
              <div>
                <p class="meta">{formatDate(post.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section>
</BaseLayout>
