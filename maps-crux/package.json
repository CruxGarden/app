{
  "name": "maps-crux",
  "private": true,
  "version": "0.1.0",
  "description": "Maps around MapLibre GL and Terra Draw with OpenFreeMap tiles as a Crux Tool: places, routes and areas on a map, with a public map edition",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode edition",
    "build:garden": "OUT_DIR=runtime vite build",
    "check": "tsc --noEmit",
    "test:garden": "node --test garden/document.test.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.9.0",
    "terra-draw": "1.33.0",
    "terra-draw-maplibre-gl-adapter": "1.4.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
