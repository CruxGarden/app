---
import settings from '../config.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="garden-brand" href={`${base}/`} aria-label={`${settings.title} documentation`}>
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13"/><path d="M16 9v14M9 16h14"/></svg>
  <span>{settings.title}</span><span class="brand-divider">/</span><span class="brand-section">Guide</span>
</a>
