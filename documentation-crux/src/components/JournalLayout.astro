---
import '../styles/garden.css';
import settings from '../config.json';
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = process.env.CRUX_DOCS_GUIDE_BASE || base;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title} · {settings.title}</title><link rel="icon" href={`${base}/mark.svg`} /></head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="journal-header"><a class="garden-brand" href={`${base}/blog/`}><svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13"/><path d="M16 9v14M9 16h14"/></svg><span>{settings.title}</span></a><nav aria-label="Main"><a href={`${base}/blog/`} aria-current="page">Journal</a><a href={`${docs}/`}>Field guide ↗</a></nav></header>
    <main id="main"><slot /></main>
    <footer class="journal-footer"><span>{settings.footer}</span><a href={`${docs}/`}>Explore the guide →</a></footer>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; } body { margin: 0; background: var(--sl-color-black); color: var(--sl-color-white); font-family: var(--sl-font); line-height: 1.75; }
  a { color: inherit; } .journal-header, .journal-footer { max-width: 1160px; margin: auto; padding: 2rem 2.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .journal-header nav { display: flex; gap: 2rem; font-size: .85rem; } .journal-header nav a, .journal-footer a { text-decoration: none; }
  main { max-width: 1160px; padding: 4rem 2.5rem 7rem; margin: auto; min-height: 65vh; }
  .eyebrow { color: var(--sl-color-accent-high); font-size: .73rem; text-transform: uppercase; letter-spacing: .15em; font-weight: 650; }
  .journal-title { font-size: clamp(3rem, 8vw, 5.5rem); font-weight: 500; max-width: 820px; margin: 1.3rem 0; }
  .intro { color: var(--sl-color-gray-2); font-size: 1.15rem; max-width: 560px; }
  .journal-footer { border-top: 1px solid var(--sl-color-gray-5); font-size: .8rem; color: var(--sl-color-gray-2); flex-wrap: wrap; }
  .skip { position: fixed; top: -5rem; left: 1rem; z-index: 10; background: var(--sl-color-black); padding: 1rem; } .skip:focus { top: 1rem; }
  @media (max-width: 600px) { main { padding: 2rem 1.25rem 4rem; } .journal-header, .journal-footer { padding: 1.5rem 1.25rem; } .journal-header nav { gap: 1rem; } }
</style>
