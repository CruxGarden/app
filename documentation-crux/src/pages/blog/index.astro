---
import { getCollection } from 'astro:content';
import Layout from '../../components/JournalLayout.astro';
const posts = (await getCollection('journal')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Garden journal" description="Notes on making things, keeping their stories, and working together.">
  <p class="eyebrow">Notes from the Garden</p>
  <h1 class="journal-title">A practice of<br />making things.</h1>
  <p class="intro">Small beginnings, useful experiments, and a little room to grow. Thoughts on creating with Crux Garden.</p>
  <div class="posts">{posts.map((post, i) => <a class="post" href={`${base}/blog/${post.id}/`}><div class:list={['cover', { blue: i % 2 === 1 }]} aria-hidden="true"><span class="orb"></span><span class="cross">+</span><span class="cover-label">{i === 0 ? 'begin anywhere' : 'grow together'}</span></div><p class="eyebrow">{post.data.category}</p><h2>{post.data.title}</h2><p class="summary">{post.data.description}</p><span class="read">Read the story <span aria-hidden="true">↗</span></span></a>)}</div>
</Layout>
<style>
  .posts { margin-top: 4rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; }
  .post { text-decoration: none; } .post h2 { font-size: 1.65rem; line-height: 1.3; font-weight: 550; margin: .75rem 0; } .post .eyebrow { margin-top: 1.5rem; }
  .summary { color: var(--sl-color-gray-2); font-size: .95rem; } .read { display: flex; justify-content: space-between; border-top: 1px solid var(--sl-color-gray-5); padding-top: 1rem; margin-top: 1.5rem; font-size: .8rem; color: var(--sl-color-accent-high); }
  .cover { aspect-ratio: 1.7; background: radial-gradient(ellipse at 30% 10%, #538967 0, transparent 70%), #12261f; border-radius: 12px; position: relative; overflow: hidden; color: #d1f1dd; }
  .cover.blue { background: radial-gradient(ellipse at 70% 20%, #486777 0, transparent 70%), #12232c; color: #d4e9f2; }
  .orb { position: absolute; width: 70%; aspect-ratio: 1; border: 1px solid #c2ead855; border-radius: 50%; left: 30%; top: -20%; box-shadow: 0 0 0 22px #d0ffed08, 0 0 0 44px #d0ffed06, 0 0 0 66px #d0ffed04; }
  .cross { position: absolute; top: 8%; left: 55%; font-size: 7rem; line-height: 1; font-weight: 200; } .cover-label { position: absolute; bottom: 12%; left: 8%; font-family: 'Garden Wordmark', Georgia, serif; font-size: clamp(2rem, 4vw, 3rem); }
  .post:hover h2 { color: var(--sl-color-accent-high); } @media (max-width: 640px) { .posts { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
