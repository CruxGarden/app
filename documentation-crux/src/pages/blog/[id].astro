---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/JournalLayout.astro';
export async function getStaticPaths() { return (await getCollection('journal')).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={post.data.title} description={post.data.description}>
  <article><a class="back" href={`${base}/blog/`}>← Garden journal</a><p class="eyebrow">{post.data.category}</p><h1>{post.data.title}</h1><p class="intro">{post.data.description}</p><div class="prose"><Content /></div></article>
</Layout>
<style>
  article { max-width: 720px; margin: auto; } h1 { font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 550; margin: 1rem 0 1.5rem; } .back { font-size: .8rem; text-decoration: none; color: var(--sl-color-gray-2); display: inline-block; margin-bottom: 3rem; } .prose { margin-top: 3rem; font-size: 1.05rem; line-height: 1.9; } .prose :global(h2) { margin-top: 2.3rem; line-height: 1.3; font-size: 1.55rem; font-weight: 550; }
</style>
